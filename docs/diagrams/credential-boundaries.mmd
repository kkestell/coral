flowchart LR
    resolve["Resolve job<br/>GitHub write token"]

    subgraph review_job["Review job"]
        orchestrator["Coral process<br/>OpenRouter API key<br/>read-only GitHub token on main pushes"]
        reviewer["Reviewer container<br/>private checkout + toolcache<br/>network, no credentials"]
        verifier["Verifier container<br/>fresh checkout + toolcache<br/>network, no credentials"]

        orchestrator <--> reviewer
        orchestrator <--> verifier
    end

    publish["Publish job<br/>GitHub write token"]
    github["GitHub<br/>review or issues"]
    openrouter["OpenRouter<br/>model provider"]

    resolve -->|resolved inputs| orchestrator
    orchestrator <--> openrouter
    orchestrator -->|validated publication bodies| publish
    publish --> github
